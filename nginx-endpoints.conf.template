# Forward the real client information so SearXNG's limiter / bot protection
# and generated links work correctly behind the reverse proxy.
proxy_set_header Host              $host;
proxy_set_header X-Real-IP         $remote_addr;
proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host  $host;
proxy_set_header X-Forwarded-Port  $server_port;
proxy_set_header Connection        "";
proxy_http_version 1.1;

# Cache the immutable static assets served by SearXNG.
location /static/ {
    access_log off;
    expires ${STATIC_CACHE_EXPIRATION};
    add_header Cache-Control "public, max-age=${STATIC_CLIENT_CACHE_MAX_AGE}";
    add_header X-Cache-Status $upstream_cache_status;

    proxy_cache searx_static;
    proxy_cache_valid 200 ${STATIC_CACHE_EXPIRATION};
    proxy_pass http://searxng-server;
}

# Allow cross-origin reads of the public instance metadata endpoints.
location ~ ^/(config|stats|healthz)$ {
    add_header 'Access-Control-Allow-Origin'  '$host';
    add_header 'Access-Control-Allow-Methods' 'GET, OPTIONS';
    proxy_pass http://searxng-server;
}

# Everything else is proxied straight to SearXNG. Result caching is left
# opt-in: caching dynamic search results across clients is a privacy
# trade-off, so it is disabled by default. Uncomment to enable it, and set
# SEARXNG_METHOD=GET so results become cacheable GET requests.
location / {
    gzip_static on;

    #proxy_cache searx_results;
    #proxy_cache_valid 200 ${RESULTS_CACHE_EXPIRATION};
    #add_header Cache-Control "public, max-age=${RESULTS_CLIENT_CACHE_MAX_AGE}";

    proxy_pass http://searxng-server;
}
